# Praetor — environment template.
# Copy to `.env` and fill real values. `.env` is git-ignored; never commit it.

# --- PostgreSQL ---
POSTGRES_DB=praetor
POSTGRES_USER=praetor
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
BACKEND_PORT=8080
# HS256 secret for signing JWTs. REQUIRED — left empty on purpose: there is no default in the
# app either, so the backend refuses to start until you set one. Fill it in your own .env with
#     openssl rand -hex 32
# Minimum 32 characters. It does NOT need to match your teammates' — each stack signs its own
# tokens. Changing it invalidates every issued token (everyone logs in again).
JWT_SECRET=
# Token lifetime in minutes.
JWT_EXPIRY_MIN=120

# --- Frontend (Angular) ---
FRONTEND_PORT=4200

# --- Judge sandbox ---
# Docker image used to compile/run submissions (no network, hard limits)
SANDBOX_IMAGE=praetor-judge:latest
# Per-submission resource ceilings (defaults; per-problem limits override in DB)
SANDBOX_CPU_SECONDS=2
SANDBOX_MEM_MB=256
SANDBOX_PIDS_MAX=64
# One sandbox container per submission (docker exec per test case) instead of one
# container per test case. Much faster; set false to fall back if the judge misbehaves.
SANDBOX_REUSE_CONTAINER=true
# Number of concurrent judge workers
JUDGE_WORKERS=2

# --- Submission rate limit ---
# Cooldown in seconds between two ACCEPTED submissions by the same user (0 disables).
# Rejected submissions (bad slug, unsupported language) do not spend it.
SUBMISSION_RATE_LIMIT_SECONDS=10
